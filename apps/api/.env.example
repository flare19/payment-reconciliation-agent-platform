# Copy to .env and fill in. `.env` is gitignored (deployment.md §4).
# Every variable the API reads, in the order src/config/env.ts reads them.

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=
CORS_ORIGIN=http://localhost:3000
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ── HTTP rate limiting (ADR-096) ─────────────────────────────────────────────
# The demo is unauthenticated by design (judges must be able to click it) and
# both meters bill by usage: Anthropic (prepaid, auto-reload OFF) and Railway
# (CPU, egress, Postgres storage). The limiter is what makes that safe.
#
# TRUST_PROXY_HOPS IS LOAD-BEARING, NOT BOILERPLATE. Railway terminates TLS at
# its edge, so at 0 every visitor shares the edge's IP and therefore ONE bucket
# -- the first judge to browse locks out the rest. 1 reads the hop the proxy
# wrote; the leftmost X-Forwarded-For entry is client-forgeable.
TRUST_PROXY_HOPS=1
RATE_LIMIT_ENABLED=true

# ── LLM (Gemini, ADR-080) ────────────────────────────────────────────────────
# One key for BOTH the explain layer (S13) and the Analyst (Phase A).
# ABSENT IS A LEGITIMATE STATE: the run completes with `explanation_source =
# 'template'` and Phase A returns 503 (ADR-017). Nothing on the engine's
# critical path needs this key.
# ─── LLM PROVIDER (ADR-093) ───────────────────────────────────────────────────
# 'anthropic' (shipped) or 'gemini' (the free-tier path, kept so the whole
# system still runs without spending a prepaid balance). ONE switch drives both
# S13 explain and Phase A: /api/health reports `llmConfigured` as a single
# boolean, and letting the two surfaces disagree would make it true while half
# the system had no key.
LLM_PROVIDER=anthropic

# Paste your key here. This file is .env.example and IS committed — put the real
# key in `.env`, which is gitignored. Never commit a key.
ANTHROPIC_API_KEY=

# Both surfaces default to claude-sonnet-5 ($2/$10 per MTok). Opus 5 is $5/$25 —
# 2.5x more on both sides — and on a hard-capped prepaid key the binding
# constraint is how many verification runs are affordable, not how good any
# single one is.
LLM_AGENT_MODEL=claude-sonnet-5
LLM_EXPLAIN_MODEL=claude-sonnet-5

# output_config.effort for the Analyst: low | medium | high | xhigh | max.
# 'high' is the sweet spot for agentic work; drop to 'medium' to cut spend.
# S13 is pinned to 'low' in code — it writes two sentences about a decision the
# rules already made and has nothing to reason about.
AGENT_EFFORT=high

# ─── the free-tier fallback (LLM_PROVIDER=gemini) ─────────────────────────────
GEMINI_API_KEY=
GEMINI_EXPLAIN_MODEL=gemini-3.5-flash
# gemini-3.6-flash, not 3.7 (ADR-086). 3.7 answers a trivial prompt in ~53 s on
# a free-tier key, and agent-design.md 8 bounds a WHOLE investigation at 60 s.
GEMINI_AGENT_MODEL=gemini-3.6-flash
LLM_EXPLAIN_ENABLED=true
LLM_MAX_CALLS_PER_RUN=8
PROMPT_VERSION=v1

# ── Engine ───────────────────────────────────────────────────────────────────
ALIAS_LEARNING_ENABLED=true
CANDIDATE_CAP=200
BATCH_SUBSET_BUDGET_MS=2000
RUN_MIGRATIONS_ON_BOOT=true
STALE_RUN_TIMEOUT_MINUTES=5

# ── The Analyst (Phase A) ────────────────────────────────────────────────────
AGENT_ENABLED=true
AGENT_MAX_INVESTIGATIONS_PER_RUN=20
AGENT_MAX_COST_USD_PER_RUN=1.0

# The DEPLOYMENT-wide ceiling for the public investigate endpoint (#61).
# A per-run cap cannot bound an unauthenticated surface: POST /api/runs mints a
# fresh run on demand, so "per run" is a ceiling the caller controls. This one is
# per wall-clock hour, derived from cost_usd rows already written, so it survives
# a restart -- an in-memory counter is one an attacker resets by crashing the
# process.
AGENT_MAX_COST_USD_PER_HOUR=2.0
# The bound that actually binds on a free-tier key: there is no bill to cap, and
# the scarce resource is requests per day (ADR-080).
AGENT_MAX_LLM_REQUESTS_PER_RUN=220
# Review-queue corroborations (ADR-081). Runs after exceptions; cut first if the
# request budget binds.
AGENT_MAX_QUEUE_TRIAGES_PER_RUN=15

# ── Pacing (services/agent/rate-limiter.ts) ──
# Set BELOW the provider's published ceiling, not at it. A refused request still
# counts against a daily quota on most tiers, so pacing at the limit spends the
# budget on 429s. Measured, not assumed: these are the Gemini free-tier figures
# this was written against (15 RPM / 250K TPM) minus a margin. Re-measure before
# adopting them for another provider (ADR-086).
AGENT_MAX_REQUESTS_PER_MINUTE=12
AGENT_MAX_TOKENS_PER_MINUTE=200000
AGENT_MAX_RETRIES=3
AGENT_QA_ENABLED=true
AGENT_QA_MAX_QUESTIONS_PER_RUN=50
AGENT_QA_MAX_QUESTIONS_PER_HOUR=100
AGENT_PROMPT_VERSION=agent-v1

# ── Datasets ─────────────────────────────────────────────────────────────────
DEV_SEED=1337
HOLDOUT_SEED=90210
