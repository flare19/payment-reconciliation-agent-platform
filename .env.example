# Copy to .env and fill in. NEVER commit .env — see docs/deployment.md §4.

# --- required ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recon
CORS_ORIGIN=http://localhost:3000

# --- LLM (optional; absent => explain layer degrades to templates, ADR-017) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_EXPLAIN_ENABLED=true
LLM_MAX_CALLS_PER_RUN=8
PROMPT_VERSION=v1

# --- engine ---
ALIAS_LEARNING_ENABLED=true
CANDIDATE_CAP=200
BATCH_SUBSET_BUDGET_MS=250
RUN_MIGRATIONS_ON_BOOT=true
STALE_RUN_TIMEOUT_MINUTES=5

# --- Phase A: the Analyst (ADR-048..057) ---
AGENT_ENABLED=true
AGENT_MAX_INVESTIGATIONS_PER_RUN=20
AGENT_MAX_COST_USD_PER_RUN=1.00
AGENT_QA_ENABLED=true
AGENT_QA_MAX_QUESTIONS_PER_RUN=50
AGENT_QA_MAX_QUESTIONS_PER_HOUR=100
AGENT_PROMPT_VERSION=agent-v1

# --- datasets (ADR-027) ---
DEV_SEED=1337
HOLDOUT_SEED=90210

LOG_LEVEL=info

# --- frontend (apps/web/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
